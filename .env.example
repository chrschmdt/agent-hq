# Postgres: pooled for the app, direct for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

QDRANT_URL=
QDRANT_API_KEY=

# Model calls, embeddings and reranking
OPENROUTER_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ahq
AHQ_TRACE_SAMPLE_RATE=0.1

# mock | low | medium | high
AHQ_MODEL_PROFILE=

# Per-role model overrides as JSON, e.g. {"support": "claude-haiku-4-5"}
AHQ_MODEL_ROLES=

# openssl rand -hex 32
AHQ_OPERATOR_TOKEN=
AHQ_MCP_TOKEN_SECRET=
CRON_SECRET=

# Admin sign-in with GitHub. AHQ_ADMIN_GITHUB_ID is the numeric account id.
# Without AUTH_SECRET the control room is read-only. Callback: https://<domain>/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AHQ_ADMIN_GITHUB_ID=

# Eval gate on GitHub Actions: a token with Actions read and write, and the repository as owner/name
AHQ_GITHUB_TOKEN=
AHQ_GITHUB_REPO=
AHQ_GITHUB_REF=

# Public address
AHQ_SITE_URL=

# Deployment
AHQ_QUEUE_BACKEND=vercel
AHQ_TOOL_TRANSPORT=http
AHQ_SEGMENT_BUDGET_S=270
VERCEL_AUTOMATION_BYPASS_SECRET=
