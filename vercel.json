{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "api", "format": "url", "env": "API_INTERNAL_URL" }]
    },
    "api": {
      "root": "apps/api/",
      "framework": "fastapi",
      "entrypoint": "pyproject.toml",
      "buildCommand": "ahq db migrate"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/mcp/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/cron/qdrant-keepalive", "schedule": "0 9 * * *" }]
}
